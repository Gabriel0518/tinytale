{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "capacitor.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist",
    "apps"
  ]
}
