{
  "name": "tinytale-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 7003",
    "dev:frontend": "next dev -H 0.0.0.0 -p 7001",
    "dev:admin": "next dev -p 7003",
    "clean:next-artifacts": "node -e \"const fs=require('fs'); ['.next','.next-admin'].forEach((dir)=>fs.rmSync(dir,{recursive:true,force:true}));\"",
    "build": "npm run clean:next-artifacts && next build",
    "build:web": "npm run build",
    "build:native-shell": "npm --workspace native-shell run build",
    "build:shared": "npm run typecheck:shared",
    "check:boundaries": "node ./scripts/check-import-boundaries.mjs",
    "check:native-release-config": "node ./scripts/check-native-release-config.mjs",
    "validate:web": "npm run check:boundaries && npm run typecheck:web && npm run build:web",
    "validate:native-shell": "npm run check:boundaries && npm run check:native-release-config && npm run typecheck:shared && npm run typecheck:native-shell && npm run build:native-shell",
    "validate:native-shell:android": "npm run validate:native-shell && npm --workspace native-shell run sync:android:assets && npm --workspace native-shell run android:assemble",
    "android:smoke:deeplinks": "./scripts/android-deeplink-smoke.sh",
    "android:smoke:push-routes": "./scripts/android-push-route-smoke.sh",
    "validate:workspace": "npm run check:boundaries && npm run typecheck:shared && npm run typecheck:web && npm run typecheck:native-shell && npm run build:web && npm run build:native-shell",
    "start": "next start",
    "lint": "next lint",
    "lint:web": "npm run lint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:shared": "tsc -p packages/shared-domain/tsconfig.json --noEmit && tsc -p packages/shared-i18n/tsconfig.json --noEmit && tsc -p packages/shared-storage/tsconfig.json --noEmit && tsc -p packages/shared-runtime/tsconfig.json --noEmit && tsc -p packages/shared-api/tsconfig.json --noEmit && tsc -p packages/shared-auth/tsconfig.json --noEmit && tsc -p packages/shared-player/tsconfig.json --noEmit",
    "typecheck:native-shell": "tsc -p apps/native-shell/tsconfig.json --noEmit",
    "dev:native-shell": "npm --workspace native-shell run dev",
    "android:copy": "npx cap copy android",
    "android:sync": "npx cap sync android",
    "android:sync:prod": "npm run build:web && npm run android:sync",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:assemble": "./scripts/with-android-studio-jdk.sh sh -lc 'cd android && ./gradlew assembleDebug'",
    "android:install": "./scripts/with-android-studio-jdk.sh sh -lc 'cd android && ./gradlew installDebug'",
    "android:package:prod": "npm run android:sync:prod && npm run android:assemble",
    "verify:prod:web": "npm run typecheck:web && npm run build:web"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.28.3",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.9",
    "@hookform/resolvers": "^5.2.2",
    "@react-oauth/google": "^0.13.4",
    "@types/video.js": "^7.3.58",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next": "14.2.35",
    "react": "^18",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-player": "^3.4.0",
    "swiper": "^12.1.1",
    "tailwind-merge": "^3.4.1",
    "tus-js-client": "^4.3.1",
    "video.js": "^8.23.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cors": "^2.8.6",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "express": "^5.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
