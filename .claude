{
  "project": {
    "name": "TinyTale",
    "description": "Netflix-style vertical short drama streaming platform"
  },
  "team": {
    "members": ["Lead Agent", "Product Agent", "Design Agent", "Dev Agent", "Audit Agent"],
    "lead": {
      "name": "Lead Agent",
      "role": "Project Lead",
      "description": "负责拆解任务、调度Agent、做最终决策",
      "enabled": true
    },
    "product": {
      "name": "Product Agent",
      "role": "Product Manager",
      "description": "负责PRD、用户路径、逻辑规则",
      "enabled": true
    },
    "design": {
      "name": "Design Agent",
      "role": "UI/UX Designer",
      "description": "负责视觉设计、交互设计、前端结构",
      "enabled": true
    },
    "dev": {
      "name": "Dev Agent",
      "role": "Developer",
      "description": "负责编写代码、修改代码、合并代码",
      "enabled": true
    },
    "audit": {
      "name": "Audit Agent",
      "role": "QA Engineer",
      "description": "负责检查冲突、风险、规范",
      "enabled": true
    }
  },
  "teamRules": {
    "communication": "Each agent ONLY speaks when assigned by Lead Agent",
    "responsibility": "Each agent MUST stay within its responsibility",
    "tools": "Each agent MUST follow its tool permissions",
    "output": "Output must clearly mark which agent is speaking"
  },
  "workflow": {
    "default": "lead → product → design → dev → audit → lead"
  }
}
