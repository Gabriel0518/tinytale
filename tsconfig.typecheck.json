{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "capacitor.config.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist",
    "apps",
    ".next",
    ".next-admin"
  ]
}
